# ===================================
# DSA ECS 部署最小配置模板
# ===================================
#
# 用法：
#   cp deploy/env.template /opt/stock-analyzer/.env
#   然后填写下面标注为「必填」的项
#
# 完整配置项（900+ 项，含各种数据源 / 策略 / 通知渠道）见仓库根目录 .env.example。
# 本文件只列部署时真正必须决策的部分。

# --- 自选股（必填）--------------------------------------------------------
# 逗号分隔。A股 6 位代码、港股 hk 前缀、美股直接写代码。
STOCK_LIST=600519,300750,002594

# --- AI 模型（至少填一个，必填）-------------------------------------------
# 推荐 AIHubMix：一个 key 用多家模型
# AIHUBMIX_KEY=
#
# 或 Anspire：一个 key 同时覆盖大模型与新闻搜索
# ANSPIRE_API_KEYS=
#
# 或任意 OpenAI 兼容服务（中转站 / 自建网关 / Ollama）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LITELLM_MODEL=openai/gpt-5.5

# --- 通知渠道（至少填一个，必填）------------------------------------------
# 飞书群机器人
# FEISHU_WEBHOOK_URL=
# 企业微信群机器人
# WECHAT_WEBHOOK_URL=
# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# 邮件
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# 自定义 Webhook（钉钉 / Slack / 自建服务，多个逗号分隔）
# CUSTOM_WEBHOOK_URLS=

# --- 定时任务 --------------------------------------------------------------
SCHEDULE_ENABLED=true
SCHEDULE_TIME=18:00
MARKET_REVIEW_ENABLED=true

# --- Web 界面与安全 --------------------------------------------------------
# 公网暴露必须开启，否则任何人打开域名都能看到配置页里的 API Key
ADMIN_AUTH_ENABLED=true
# 仅在「Nginx → 应用」单层可信代理下开启；前面若挂了 CDN 请保持 false
# （多级代理会让登录限流的 key 退化为边缘代理 IP）
TRUST_X_FORWARDED_FOR=true

# --- ECS 环境调优 ----------------------------------------------------------
# 并发抓取线程数，小机器建议 1-2，防数据源封禁
MAX_WORKERS=2
# 筹码分布接口不稳定，云端部署建议关闭
ENABLE_CHIP_DISTRIBUTION=false
# 资讯源自动拉取（内置财联社 / 雪球热门 / 华尔街见闻 / 金十 / 格隆汇）。
# 注意：默认依赖 NewsNow 公开示例实例，稳定性无保障，长期运行建议自建，
# 详见 docs/intelligence-sources.md
NEWS_INTEL_AUTO_FETCH_ENABLED=true
